generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                 String   @id @default(cuid())
  slug               String   @unique
  sku                String   @unique
  oemRef             String
  nameVi             String
  nameJp             String
  kanjiMark          String?
  brand              String
  category           String
  priceVnd           Int
  originalPriceVnd   Int?
  stockStatus        String
  stockQty           Int
  image              String
  badgeText          String
  compatibleVehicles String[]
  specsJson          Json
  summaryVi          String
  highlights         String[]
  videoPreviewUrl    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model VehicleFitment {
  id                 String   @id @default(cuid())
  make               String
  model              String
  years              String[]
  recommendedSockets String[]

  @@unique([make, model])
}

model VehicleBuildCombo {
  id                String   @id @default(cuid())
  vehicleTitle      String
  jpSubtitle        String
  driverStyle       String
  image             String
  recommendedMode   String
  descriptionVi     String
  productIds        String[]
  bundleDiscountPct Int
}

model Order {
  id              String      @id @default(cuid())
  orderCode       String      @unique
  customerId      String?
  customerName    String
  phone           String
  vehicleInfo     String
  shippingAddress String
  note            String?
  subtotalVnd     Int
  discountVnd     Int         @default(0)
  voucherCode     String?
  shippingFeeVnd  Int
  totalVnd        Int
  paymentStatus   String      @default("unpaid")
  paymentRef      String?
  status          String      @default("pending_confirm")
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([customerId])
  @@index([phone])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  sku            String
  nameVi         String
  quantity       Int
  selectedKelvin String?
  unitPriceVnd   Int
  lineTotalVnd   Int
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model DailyInventoryLog {
  id          String   @id @default(cuid())
  productId   String
  sku         String
  deltaQty    Int
  previousQty Int
  newQty      Int
  reason      String
  actor       String
  createdAt   DateTime @default(now())
}

model ProductReview {
  id               String   @id @default(cuid())
  productId        String
  customerId       String?
  customerName     String
  vehicleInfo      String
  rating           Int
  title            String
  comment          String
  beamMode         String?
  photoUrl         String?
  verifiedPurchase Boolean  @default(false)
  orderCode        String?
  status           String   @default("pending")
  adminNote        String?
  createdAt        DateTime @default(now())

  @@index([productId, status])
  @@index([status, createdAt])
}

model CustomerUser {
  id                 String   @id @default(cuid())
  fullName           String
  phone              String?  @unique
  email              String?  @unique
  passwordHash       String
  shippingAddress    String?
  garageVehiclesJson Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Voucher {
  id             String    @id @default(cuid())
  code           String    @unique
  title          String
  descriptionVi  String
  discountType   String
  discountValue  Int
  minOrderVnd    Int       @default(0)
  maxDiscountVnd Int?
  usageLimit     Int?
  usedCount      Int       @default(0)
  active         Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
}

model InstallationBooking {
  id           String   @id @default(cuid())
  bookingCode  String   @unique
  customerId   String?
  orderCode    String?
  customerName String
  phone        String
  vehicleInfo  String
  garageBranch String
  serviceType  String
  bookingDate  String
  timeSlot     String
  note         String?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([bookingDate, garageBranch])
  @@index([customerId])
  @@index([phone])
}

